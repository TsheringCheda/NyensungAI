# Keep this private and use the same value as backend AGENT_API_KEY
NYENSUNG_AGENT_API_KEY=replace-with-the-same-agent-key
NYENSUNG_API_URL=http://127.0.0.1:8000/api/security-events/
NYENSUNG_POLL_INTERVAL=10
# First-run history window; avoids replaying the entire event log
NYENSUNG_INITIAL_BACKFILL_HOURS=24
# Process creation can be high-volume and requires Audit Process Creation policy
NYENSUNG_ENABLE_PROCESS_EVENTS=false
NYENSUNG_ENABLE_DEFENDER_EVENTS=true
