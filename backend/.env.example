# Copy this file to .env and set a long random secret key.
SECRET_KEY=replace-with-a-long-random-secret-key
PROJECT_NAME=NyensungAI
ENVIRONMENT=development
# Keep the existing database path to preserve your current events and users.
DATABASE_URL=sqlite:///./sentinelai.db
FRONTEND_URL=http://localhost:5173
# Generate a unique value and share it only with your trusted endpoint agent.
AGENT_API_KEY=replace-with-a-long-random-agent-key
